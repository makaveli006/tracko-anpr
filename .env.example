# Copy this file to .env and set a real password. .env is git-ignored; never commit it.

# PostgreSQL 18 (Docker inside WSL). Used by docker-compose.yml and by the application.
POSTGRES_USER=tracko
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracko_anpr
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional overrides. The defaults are in src/tracko_anpr/config.py.
# TRACKO_VEHICLE_WEIGHTS=models/yolo26m.pt
# TRACKO_VEHICLE_IMAGE_SIZE=1536
# TRACKO_VEHICLE_CONFIDENCE=0.1
# TRACKO_TRACKER_LOST_SECONDS=1.0
# TRACKO_PLATE_WEIGHTS=models/plate/sentry-26s.safetensors
# TRACKO_PLATE_IMAGE_SIZE=640
# TRACKO_PLATE_CONFIDENCE=0.25
# TRACKO_OCR_START_TIMEOUT=180      # seconds allowed for the plate reader to load its model
# TRACKO_OCR_REQUEST_TIMEOUT=60     # seconds allowed for one batch of plates
# TRACKO_WEB_HOST=0.0.0.0           # the web app listens here; 0.0.0.0 so the Windows browser can reach WSL
# TRACKO_WEB_PORT=8080
